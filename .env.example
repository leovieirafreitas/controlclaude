# Segredos locais. NÃO commitar (já está no .gitignore).
RESEND_API_KEY=
RESEND_FROM=
# Para usar leovieiradefreitas@gmail.com, verifique um domínio no Resend e troque o RESEND_FROM.
ADMIN_EMAILS=
SESSION_SECRET=

# Mercado Pago — em TESTE. Para vender de verdade, troque pelas de produção (MP_*_PROD abaixo).
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
APP_URL=http://localhost:5173

# Supabase (Postgres). O "@" da senha vai codificado como %40.
# Supabase → Project Settings → Database → Database password (se não lembrar, clique em "Reset database password").
DATABASE_URL=


# Mercado Pago — credenciais de PRODUÇÃO (dinheiro real)
MP_PUBLIC_KEY_PROD=
MP_ACCESS_TOKEN_PROD=

# WhatsApp (Evolution API) — avisos para o admin
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_TOKEN=
# Número que recebe os avisos (formato do WhatsApp: 55 + DDD + número; DDD 92 sem o 9 extra). Vários: separe por vírgula.
WHATSAPP_ADMIN_NUMBERS=
NOTIFY_TIMEZONE=America/Manaus
# Mensagens para o cliente no WhatsApp (boas-vindas, lembrete, atraso): on / off
WHATSAPP_CUSTOMER_MESSAGES=on
# Lembrete de vencimento: quantos dias antes
REMINDER_DAYS_BEFORE=3

# Só em ambiente de TESTE (nunca na produção): e-mail do comprador de teste do Mercado Pago, exigido pelas assinaturas no sandbox
# MP_TEST_PAYER_EMAIL=

# Pix como alternativa ao cartão com renovação automática (on/off). Padrão: on
# PIX_ENABLED=on

# Assinatura secreta do webhook do Mercado Pago (painel do MP → Suas integrações → Webhooks → "Assinatura secreta").
# Com ela, avisos falsos são recusados. Sem ela, o sistema ainda confere cada aviso direto na API do Mercado Pago.
# MP_WEBHOOK_SECRET=

# Google Workspace: e-mail institucional criado para cada novo assinante (nome@controlclaude.com.br)
# JSON da conta de serviço numa linha só (ou em base64). Nunca coloque o arquivo no Git.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Super administrador do Workspace em nome de quem a conta de serviço age
# GOOGLE_ADMIN_SUBJECT=
# WORKSPACE_DOMAIN=controlclaude.com.br
# WORKSPACE_AUTO_CREATE=on
# Grupo do Google em que cada membro novo entra (e-mail do grupo)
# WORKSPACE_GROUP=
